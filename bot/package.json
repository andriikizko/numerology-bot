{
  "name": "numerology-bot",
  "version": "1.0.0",
  "description": "Numerology Telegram Bot SaaS",
  "main": "src/bot.js",
  "type": "module",
  "scripts": {
    "start": "node src/bot.js",
    "start:server": "node src/server.js",
    "dev": "NODE_ENV=development node src/bot.js",
    "dev:server": "NODE_ENV=development node src/server.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "test": "node --test tests/**/*.test.js"
  },
  "dependencies": {
    "telegraf": "^4.14.0",
    "firebase-admin": "^12.0.0",
    "express": "^4.18.2",
    "node-cron": "^3.0.2",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "crypto": "^1.0.1"
  },
  "devDependencies": {
    "eslint": "^8.54.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
